# --- Base de datos (Supabase → Project Settings → Database → Connection string) ---
# Pooler "Transaction" (puerto 6543), con ?pgbouncer=true&connection_limit=1 al final
DATABASE_URL="postgresql://postgres.xxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Pooler "Session" (puerto 5432): para migraciones
DIRECT_URL="postgresql://postgres.xxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- Sesiones: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# --- Respaldos en Supabase Storage (Project Settings → API) ---
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# --- Cron de Vercel (cualquier texto largo aleatorio) ---
CRON_SECRET=""

# --- Solo para el seed inicial (opcional): contraseñas con que entran la primera vez ---
CLAVE_INICIAL_JULIO=""
CLAVE_INICIAL_ESPOSA=""
